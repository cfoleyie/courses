# Copy to .env next to docker-compose.yml. Never commit the real thing.

# Reading order emails over IMAP. For Gmail this must be a 16-character app
# password from myaccount.google.com/apppasswords, not your normal password.
TROLLEY_IMAP_PASSWORD=

# Only needed if notify.channel is "smtp" or "ntfy".
TROLLEY_SMTP_PASSWORD=
TROLLEY_NTFY_TOKEN=
