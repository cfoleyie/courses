# Copy to .env next to docker-compose.yml. Never commit the real thing.
# For a non-Docker install these go in .env.local instead, which
# `switchtime nintendo-login` and `tools/install-service.sh` create for you.
NINTENDO_SESSION_TOKEN=
# The family IXL account everyone signs in with:
IXL_FAMILY_PASSWORD=
# Each child's own short password, entered after picking their name:
IXL_PROFILE_OLIVER=
IXL_PROFILE_ELEANOR=
IXL_PROFILE_ALICE=
SWITCHTIME_PIN=1234
